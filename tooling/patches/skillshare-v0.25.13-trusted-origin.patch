+func TestTrustedResourceOrigin(t *testing.T) {
+	const origin = "https://fwd.seso.icu:34000"
+	for _, tc := range []struct {
+		name, host, peer, origin, site, proto, configuredOrigin, configuredProxy string
+		want                                                                     bool
+	}{
+		{"browser through trusted proxy", "fwd.seso.icu:34000", "10.0.0.2:44000", "", "same-origin", "https", origin, "10.0.0.2", true},
+		{"explicit exact origin", "fwd.seso.icu:34000", "10.0.0.2:44000", origin, "", "https", origin, "10.0.0.2", true},
+		{"exact origin and fetch metadata", "fwd.seso.icu:34000", "10.0.0.2:44000", origin, "same-origin", "https", origin, "10.0.0.2", true},
+		{"disabled by default", "fwd.seso.icu:34000", "10.0.0.2:44000", origin, "same-origin", "https", "", "", false},
+		{"missing proxy policy", "fwd.seso.icu:34000", "10.0.0.2:44000", origin, "same-origin", "https", origin, "", false},
+		{"forged forwarded peer", "fwd.seso.icu:34000", "10.0.0.99:44000", origin, "same-origin", "https", origin, "10.0.0.2", false},
+		{"unparseable peer", "fwd.seso.icu:34000", "10.0.0.2", origin, "same-origin", "https", origin, "10.0.0.2", false},
+		{"wrong domain", "evil.example:34000", "10.0.0.2:44000", "https://evil.example:34000", "same-origin", "https", origin, "10.0.0.2", false},
+		{"domain suffix", "fwd.seso.icu.evil.example:34000", "10.0.0.2:44000", origin, "same-origin", "https", origin, "10.0.0.2", false},
+		{"wrong port", "fwd.seso.icu:443", "10.0.0.2:44000", origin, "same-origin", "https", origin, "10.0.0.2", false},
+		{"missing port", "fwd.seso.icu", "10.0.0.2:44000", origin, "same-origin", "https", origin, "10.0.0.2", false},
+		{"trailing dot", "fwd.seso.icu.:34000", "10.0.0.2:44000", origin, "same-origin", "https", origin, "10.0.0.2", false},
+		{"cross site", "fwd.seso.icu:34000", "10.0.0.2:44000", origin, "cross-site", "https", origin, "10.0.0.2", false},
+		{"same site is not same origin", "fwd.seso.icu:34000", "10.0.0.2:44000", "", "same-site", "https", origin, "10.0.0.2", false},
+		{"foreign origin", "fwd.seso.icu:34000", "10.0.0.2:44000", "https://evil.example", "same-origin", "https", origin, "10.0.0.2", false},
+		{"insecure origin", "fwd.seso.icu:34000", "10.0.0.2:44000", "http://fwd.seso.icu:34000", "same-origin", "https", origin, "10.0.0.2", false},
+		{"null origin", "fwd.seso.icu:34000", "10.0.0.2:44000", "null", "same-origin", "https", origin, "10.0.0.2", false},
+		{"missing browser proof", "fwd.seso.icu:34000", "10.0.0.2:44000", "", "", "https", origin, "10.0.0.2", false},
+		{"insecure forwarding", "fwd.seso.icu:34000", "10.0.0.2:44000", origin, "same-origin", "http", origin, "10.0.0.2", false},
+		{"ambiguous forwarding", "fwd.seso.icu:34000", "10.0.0.2:44000", origin, "same-origin", "https,http", origin, "10.0.0.2", false},
+		{"wildcard policy rejected", "fwd.seso.icu:34000", "10.0.0.2:44000", origin, "same-origin", "https", "https://*.seso.icu:34000", "10.0.0.2", false},
+		{"policy userinfo rejected", "fwd.seso.icu:34000", "10.0.0.2:44000", origin, "same-origin", "https", "https://user@fwd.seso.icu:34000", "10.0.0.2", false},
+		{"policy path rejected", "fwd.seso.icu:34000", "10.0.0.2:44000", origin, "same-origin", "https", origin + "/", "10.0.0.2", false},
+		{"invalid proxy policy", "fwd.seso.icu:34000", "10.0.0.2:44000", origin, "same-origin", "https", origin, "gateway.example", false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Setenv("SKILLSHARE_UI_TRUSTED_ORIGIN", tc.configuredOrigin)
+			t.Setenv("SKILLSHARE_UI_TRUSTED_PROXY", tc.configuredProxy)
+			r := httptest.NewRequest(http.MethodGet, "/api/mcp", nil)
+			r.Host = tc.host
+			r.RemoteAddr = tc.peer
+			if tc.origin != "" {
+				r.Header.Set("Origin", tc.origin)
+			}
+			if tc.site != "" {
+				r.Header.Set("Sec-Fetch-Site", tc.site)
+			}
+			r.Header.Set("X-Forwarded-Proto", tc.proto)
+			r.Header.Set("X-Forwarded-For", "10.0.0.2")
+			if got := resourceManagementRequestAllowed(r, "10.0.0.186:34000"); got != tc.want {
+				t.Fatalf("got %v, want %v", got, tc.want)
+			}
+		})
+	}
+}
+
+func TestTrustedResourceOriginWrappers(t *testing.T) {
+	t.Setenv("SKILLSHARE_UI_TRUSTED_ORIGIN", "https://fwd.seso.icu:34000")
+	t.Setenv("SKILLSHARE_UI_TRUSTED_PROXY", "10.0.0.2")
+	s := &Server{addr: "10.0.0.186:34000"}
+	for name, wrap := range map[string]func(http.HandlerFunc) http.HandlerFunc{"mcp": s.requireLocalMCP, "hooks": s.requireLocalHooks, "plugins": s.requireLocalPlugin} {
+		t.Run(name, func(t *testing.T) {
+			for _, host := range []string{"fwd.seso.icu:34000", "evil.example:34000"} {
+				r := httptest.NewRequest(http.MethodGet, "/api/"+name, nil)
+				r.Host = host
+				r.RemoteAddr = "10.0.0.2:44000"
+				r.Header.Set("Sec-Fetch-Site", "same-origin")
+				r.Header.Set("X-Forwarded-Proto", "https")
+				w := httptest.NewRecorder()
+				called := false
+				wrap(func(w http.ResponseWriter, r *http.Request) { called = true; w.WriteHeader(http.StatusNoContent) })(w, r)
+				if host == "fwd.seso.icu:34000" {
+					if !called || w.Code != 204 {
+						t.Fatalf("allowlisted handler not reached: %d", w.Code)
+					}
+				} else if called || w.Code != 403 {
+					t.Fatalf("foreign host reached handler: %d", w.Code)
+				}
+			}
+		})
+	}
+}
+
+func TestTrustedResourceOriginPreservesNativeAccess(t *testing.T) {
+	for _, enabled := range []bool{false, true} {
+		if enabled {
+			t.Setenv("SKILLSHARE_UI_TRUSTED_ORIGIN", "https://fwd.seso.icu:34000")
+			t.Setenv("SKILLSHARE_UI_TRUSTED_PROXY", "10.0.0.2")
+		} else {
+			t.Setenv("SKILLSHARE_UI_TRUSTED_ORIGIN", "")
+			t.Setenv("SKILLSHARE_UI_TRUSTED_PROXY", "")
+		}
+		for _, host := range []string{"localhost:34000", "10.0.0.186:34000"} {
+			r := httptest.NewRequest(http.MethodGet, "/api/mcp", nil)
+			r.Host = host
+			r.RemoteAddr = "127.0.0.1:44000"
+			if !resourceManagementRequestAllowed(r, "10.0.0.186:34000") {
+				t.Fatalf("native access rejected, policy=%v host=%s", enabled, host)
+			}
+			r.Header.Set("Sec-Fetch-Site", "cross-site")
+			if resourceManagementRequestAllowed(r, "10.0.0.186:34000") {
+				t.Fatal("cross-site native access was allowed")
+			}
+		}
+	}
+}
+
+func TestTrustedResourceOriginRejectsDuplicateHeaders(t *testing.T) {
+	t.Setenv("SKILLSHARE_UI_TRUSTED_ORIGIN", "https://fwd.seso.icu:34000")
+	t.Setenv("SKILLSHARE_UI_TRUSTED_PROXY", "10.0.0.2")
+	for _, header := range []string{"Origin", "Sec-Fetch-Site", "X-Forwarded-Proto"} {
+		r := httptest.NewRequest(http.MethodGet, "/api/mcp", nil)
+		r.Host = "fwd.seso.icu:34000"
+		r.RemoteAddr = "10.0.0.2:44000"
+		r.Header.Set("Origin", "https://fwd.seso.icu:34000")
+		r.Header.Set("Sec-Fetch-Site", "same-origin")
+		r.Header.Set("X-Forwarded-Proto", "https")
+		r.Header.Add(header, r.Header.Get(header))
+		if resourceManagementRequestAllowed(r, "10.0.0.186:34000") {
+			t.Fatalf("duplicate %s accepted", header)
+		}
+	}
+}
