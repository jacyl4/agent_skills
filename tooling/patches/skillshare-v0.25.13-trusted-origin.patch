+package server
+
+import (
+	"net"
+	"net/http"
+	"net/url"
+	"os"
+	"strings"
+)
+
+// resourceManagementRequestAllowed preserves the upstream rebinding guard and
+// optionally admits one explicitly configured HTTPS origin through one TCP peer.
+// This deployment-only policy does not change restart/upgrade authorization,
+// trust forwarded addresses as identities, or grant a native Agent's approval.
+func resourceManagementRequestAllowed(r *http.Request, serverAddr string) bool {
+	if mcpRequestAllowed(r, serverAddr) {
+		return true
+	}
+	if !restartRequestAllowed(r, serverAddr) {
+		return false
+	}
+	origin, err := url.Parse(os.Getenv("SKILLSHARE_UI_TRUSTED_ORIGIN"))
+	if err != nil || origin.Scheme != "https" || origin.Host == "" || origin.User != nil || origin.Path != "" || origin.RawQuery != "" || origin.ForceQuery || origin.Fragment != "" || strings.ContainsAny(origin.Host, "*\\ \t\r\n") {
+		return false
+	}
+	if !strings.EqualFold(r.Host, origin.Host) {
+		return false
+	}
+	proxy := net.ParseIP(os.Getenv("SKILLSHARE_UI_TRUSTED_PROXY"))
+	peer, _, err := net.SplitHostPort(r.RemoteAddr)
+	if err != nil || proxy == nil || !proxy.Equal(net.ParseIP(peer)) {
+		return false
+	}
+	// Only the authenticated-by-network proxy can assert the external TLS scheme.
+	if r.Header.Get("X-Forwarded-Proto") != "https" {
+		return false
+	}
+	if len(r.Header.Values("Origin")) > 1 || len(r.Header.Values("Sec-Fetch-Site")) > 1 || len(r.Header.Values("X-Forwarded-Proto")) > 1 {
+		return false
+	}
+	browserOrigin := r.Header.Get("Origin")
+	if browserOrigin != "" && !strings.EqualFold(browserOrigin, origin.String()) {
+		return false
+	}
+	fetchSite := r.Header.Get("Sec-Fetch-Site")
+	if fetchSite != "" && fetchSite != "same-origin" {
+		return false
+	}
+	return browserOrigin != "" || fetchSite == "same-origin"
+}
